# Copy to .env and fill in. Never paste keys into chat. Placeholders only in this file.

# Planner LLM: anthropic | openai | mock (mock = no LLM, local workflows only)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# Optional, for cost estimates (USD per million tokens). Leave empty and cost shows as unknown.
LLM_INPUT_COST_PER_MTOK=
LLM_OUTPUT_COST_PER_MTOK=

# Notion (share the parent page with your integration)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# Voice
STT_MODEL=base
TTS_ENABLED=true

# Execution
DRY_RUN=false

# Microsoft UFO2 (its own API key lives in vendor\UFO\config\ufo\agents.yaml)
UFO_ENABLED=true
UFO_TIMEOUT_S=180
