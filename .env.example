# Copy to .env and fill in. Never paste keys into chat. Placeholders only in this file.

# Planner LLM: anthropic | openai | mock (mock = no LLM, local workflows only)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# Only for LLM_PROVIDER=openai with a non-OpenAI server. Free options:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai   (LLM_MODEL=gemini-2.5-flash, key from aistudio.google.com)
#   Groq:   https://api.groq.com/openai/v1                           (LLM_MODEL=llama-3.3-70b-versatile, key from console.groq.com)
#   Ollama: http://localhost:11434/v1                                 (local, no key; small models plan poorly)
LLM_BASE_URL=
# Optional, for cost estimates (USD per million tokens). Leave empty and cost shows as unknown.
LLM_INPUT_COST_PER_MTOK=
LLM_OUTPUT_COST_PER_MTOK=

# Notion (share the parent page with your integration)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# Voice
STT_MODEL=base
TTS_ENABLED=true

# Execution
# Open JARVIS's browser on YouTube at startup (faster first command). false = open it on first use.
BROWSER_PREWARM=true
DRY_RUN=false

# Microsoft UFO2 (its own API key lives in vendor\UFO\config\ufo\agents.yaml)
UFO_ENABLED=true
UFO_TIMEOUT_S=180
